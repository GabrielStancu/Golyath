<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Golyath.MainPage"
             Title="Dashboard"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Profile" Clicked="OnProfileClicked" Order="Primary" Priority="0" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                         Spacing="16" Padding="32">

        <Label Text="🏋️" FontSize="64" HorizontalOptions="Center" />

        <Label Text="Dashboard coming soon"
               FontSize="22" FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="{AppThemeBinding Light=#111111, Dark=White}" />

        <Label Text="Your workout history, progress charts, and smart suggestions will appear here."
               FontSize="15"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               TextColor="{AppThemeBinding Light=#777777, Dark=#999999}" />

        <Button Text="My Profile"
                Clicked="OnProfileClicked"
                BackgroundColor="{StaticResource Accent}"
                TextColor="{StaticResource AccentText}"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="48"
                Margin="0,16,0,0" />

    </VerticalStackLayout>

</ContentPage>
