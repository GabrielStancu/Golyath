<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Golyath.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Golyath"
    xmlns:exercises="clr-namespace:Golyath.UI.Views.Exercises"
    Title="Golyath"
    FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Exercises"
            ContentTemplate="{DataTemplate exercises:ExerciseLibraryPage}"
            Route="ExerciseLibrary" />
    </TabBar>

</Shell>
