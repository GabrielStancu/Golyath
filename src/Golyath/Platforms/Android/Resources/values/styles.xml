<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Maui.MainTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:colorBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>

    <style name="Maui.SplashTheme" parent="Maui.MainTheme">
        <item name="android:windowBackground">@drawable/maui_splash</item>
    </style>

    <style name="Maui.MainTheme.NoActionBar" parent="Maui.MainTheme" />

    <!-- Override dialog theme to avoid dialogCornerRadius issues -->
    <style name="ThemeOverlay.MaterialComponents.Dialog" parent="@style/ThemeOverlay.MaterialComponents.Dialog">
    </style>
</resources>
