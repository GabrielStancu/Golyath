<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Golyath.UI.ViewModels.Exercises"
             x:Class="Golyath.UI.Views.Exercises.CreateExercisePage"
             x:DataType="vm:CreateExerciseViewModel"
             Title="New Exercise"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cancel"
                     Command="{Binding CancelCommand}"
                     Order="Primary"
                     Priority="0" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <!-- Name -->
            <VerticalStackLayout Spacing="6">
                <Label Text="EXERCISE NAME"
                       TextColor="{AppThemeBinding Light=#777777, Dark=#888888}"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1" />
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource AppLightSurface}, Dark={StaticResource AppDarkSurface}}"
                        Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="14,0">
                    <Entry Text="{Binding Name}"
                           Placeholder="e.g. Bulgarian Split Squat"
                           PlaceholderColor="{AppThemeBinding Light=#AAAAAA, Dark=#555555}"
                           TextColor="{AppThemeBinding Light=#111111, Dark=White}"
                           BackgroundColor="Transparent"
                           ReturnType="Next"
                           HeightRequest="48" />
                </Border>
            </VerticalStackLayout>

            <!-- Primary Muscle -->
            <VerticalStackLayout Spacing="6">
                <Label Text="PRIMARY MUSCLE"
                       TextColor="{AppThemeBinding Light=#777777, Dark=#888888}"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1" />
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource AppLightSurface}, Dark={StaticResource AppDarkSurface}}"
                        Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="4,0">
                    <Picker ItemsSource="{Binding MuscleGroupOptions}"
                            SelectedIndex="{Binding SelectedMuscleGroupIndex}"
                            TextColor="{AppThemeBinding Light=#111111, Dark=White}"
                            BackgroundColor="Transparent"
                            HeightRequest="48" />
                </Border>
            </VerticalStackLayout>

            <!-- Equipment -->
            <VerticalStackLayout Spacing="6">
                <Label Text="EQUIPMENT"
                       TextColor="{AppThemeBinding Light=#777777, Dark=#888888}"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1" />
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource AppLightSurface}, Dark={StaticResource AppDarkSurface}}"
                        Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="4,0">
                    <Picker ItemsSource="{Binding EquipmentOptions}"
                            SelectedIndex="{Binding SelectedEquipmentIndex}"
                            TextColor="{AppThemeBinding Light=#111111, Dark=White}"
                            BackgroundColor="Transparent"
                            HeightRequest="48" />
                </Border>
            </VerticalStackLayout>

            <!-- Movement Type -->
            <VerticalStackLayout Spacing="6">
                <Label Text="MOVEMENT TYPE"
                       TextColor="{AppThemeBinding Light=#777777, Dark=#888888}"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1" />
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource AppLightSurface}, Dark={StaticResource AppDarkSurface}}"
                        Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="4,0">
                    <Picker ItemsSource="{Binding MovementTypeOptions}"
                            SelectedIndex="{Binding SelectedMovementTypeIndex}"
                            TextColor="{AppThemeBinding Light=#111111, Dark=White}"
                            BackgroundColor="Transparent"
                            HeightRequest="48" />
                </Border>
            </VerticalStackLayout>

            <!-- Notes -->
            <VerticalStackLayout Spacing="6">
                <Label Text="NOTES (OPTIONAL)"
                       TextColor="{AppThemeBinding Light=#777777, Dark=#888888}"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1" />
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource AppLightSurface}, Dark={StaticResource AppDarkSurface}}"
                        Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="14,8">
                    <Editor Text="{Binding Notes}"
                            Placeholder="Cues, variations, personal tips…"
                            PlaceholderColor="{AppThemeBinding Light=#AAAAAA, Dark=#555555}"
                            TextColor="{AppThemeBinding Light=#111111, Dark=White}"
                            BackgroundColor="Transparent"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="80" />
                </Border>
            </VerticalStackLayout>

            <!-- Save button -->
            <Button Text="SAVE EXERCISE"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="{StaticResource Accent}"
                    TextColor="{StaticResource AccentText}"
                    FontAttributes="Bold"
                    FontSize="15"
                    CornerRadius="14"
                    HeightRequest="56"
                    CharacterSpacing="1"
                    Margin="0,10,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Accent}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
