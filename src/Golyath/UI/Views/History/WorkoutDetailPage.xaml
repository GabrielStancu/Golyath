<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Golyath.UI.ViewModels.History"
             x:Class="Golyath.UI.Views.History.WorkoutDetailPage"
             x:DataType="vm:WorkoutDetailViewModel"
             Title="Workout"
             BackgroundColor="{StaticResource AppDarkBg}">

    <Grid>
        <!-- Loading -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Accent}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

        <!-- Not found -->
        <VerticalStackLayout IsVisible="{Binding NotFound}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="8">
            <Label Text="Workout not found"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource TextSecondaryDark}" />
        </VerticalStackLayout>

        <!-- Detail content -->
        <Grid IsVisible="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
              RowDefinitions="Auto,*">

            <!-- Header (always dark) -->
            <Grid Grid.Row="0"
                  BackgroundColor="{StaticResource AppDarkBg}"
                  Padding="16,14,16,16"
                  RowDefinitions="Auto,Auto">

                <!-- Title row: workout name -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="0,0,0,6">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Detail.DisplayName}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="{Binding Detail.DateFormatted}"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondaryDark}" />
                    </VerticalStackLayout>

                    <!-- PR badge -->
                    <Border Grid.Column="1"
                            IsVisible="{Binding Detail.HasPersonalRecords}"
                            StrokeShape="RoundRectangle 4"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource Accent}"
                            Padding="10,6"
                            VerticalOptions="Center">
                        <Label Text="{Binding Detail.PrBadgeText}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#111111" />
                    </Border>
                </Grid>

                <!-- Duration and Stats -->
                <Grid Grid.Row="1"
                      ColumnDefinitions="Auto,Auto"
                      ColumnSpacing="20"
                      Margin="0,6,0,0">
                    <VerticalStackLayout Grid.Column="0" Spacing="0">
                        <Label Text="DURATION"
                               FontSize="9"
                               CharacterSpacing="1.2"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextMutedDark}" />
                        <Label Text="{Binding Detail.DurationFormatted}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Accent}" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>

            <!-- Scrollable content -->
            <ScrollView Grid.Row="1" IsVisible="{Binding NotFound, Converter={StaticResource InvertBoolConverter}}">
                <VerticalStackLayout Padding="16,12,16,24" Spacing="12">

                    <!-- Workout notes -->
                    <VerticalStackLayout Spacing="4" Margin="0,0,0,10">
                        <Label Text="WORKOUT NOTES"
                               FontSize="10"
                               FontAttributes="Bold"
                               CharacterSpacing="1"
                               TextColor="{StaticResource TextMutedDark}" />
                        <Border StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource CardBorderDark}"
                                Padding="12,4">
                            <Editor Text="{Binding EditableNotes, Mode=TwoWay}"
                                    Placeholder="Add workout notes..."
                                    BackgroundColor="Transparent"
                                    TextColor="White"
                                    FontSize="13"
                                    MinimumHeightRequest="60"
                                    AutoSize="TextChanges"
                                    VerticalTextAlignment="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Exercise cards -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryExerciseViewModel">
                                <Border BackgroundColor="{StaticResource CardSurfaceDark}"
                                        Stroke="{StaticResource CardBorderDark}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 4"
                                        Padding="14,12">
                                    <VerticalStackLayout Spacing="10">

                                        <!-- Exercise header: name + sets summary -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0"
                                                   Text="{Binding ExerciseName}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   VerticalOptions="Center" />

                                            <Label Grid.Column="1"
                                                   Text="{Binding SetsSummary}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextSecondaryDark}"
                                                   VerticalOptions="Center" />
                                        </Grid>

                                        <!-- Exercise notes (editable) -->
                                        <Border StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                BackgroundColor="{StaticResource CardBorderDark}"
                                                Padding="12,0">
                                            <Entry Text="{Binding ExerciseNotes, Mode=TwoWay}"
                                                   Placeholder="Exercise notes..."
                                                   BackgroundColor="Transparent"
                                                   TextColor="White"
                                                   FontSize="12"
                                                   VerticalTextAlignment="Center" />
                                        </Border>

                                        <!-- Column headers: KG · REPS · TEMPO -->
                                        <Grid ColumnDefinitions="*,*,*"
                                              ColumnSpacing="6"
                                              Padding="0,0,0,2">
                                            <Label Grid.Column="0"
                                                   Text="WEIGHT"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   CharacterSpacing="1"
                                                   TextColor="{StaticResource TextMutedDark}" />
                                            <Label Grid.Column="1"
                                                   Text="REPS"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   CharacterSpacing="1"
                                                   TextColor="{StaticResource TextMutedDark}"
                                                   HorizontalOptions="Center" />
                                            <Label Grid.Column="2"
                                                   Text="TEMPO"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   CharacterSpacing="1"
                                                   TextColor="{StaticResource TextMutedDark}"
                                                   HorizontalOptions="Center" />
                                        </Grid>

                                        <!-- ── Set rows ───────────────────────── -->
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}"
                                                             Spacing="5">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:HistorySetViewModel">
                                                    
                                                    <Border StrokeShape="RoundRectangle 4"
                                                            BackgroundColor="#1A1A1A"
                                                            StrokeThickness="0"
                                                            Padding="8,6">
                                                        <Grid ColumnDefinitions="*,*,*"
                                                              ColumnSpacing="6">

                                                            <!-- KG -->
                                                            <Border Grid.Column="0"
                                                                    StrokeShape="RoundRectangle 3"
                                                                    Stroke="#2A2A2A"
                                                                    StrokeThickness="1"
                                                                    BackgroundColor="Transparent"
                                                                    Padding="4,2">
                                                                <Label Text="{Binding WeightText}"
                                                                       FontSize="15"
                                                                       FontAttributes="Bold"
                                                                       TextColor="White"
                                                                       VerticalOptions="Center" />
                                                            </Border>

                                                            <!-- REPS -->
                                                            <Border Grid.Column="1"
                                                                    StrokeShape="RoundRectangle 3"
                                                                    Stroke="#2A2A2A"
                                                                    StrokeThickness="1"
                                                                    BackgroundColor="Transparent"
                                                                    Padding="4,2">
                                                                <Label Text="{Binding RepsText}"
                                                                       FontSize="15"
                                                                       FontAttributes="Bold"
                                                                       TextColor="White"
                                                                       HorizontalOptions="Center"
                                                                       VerticalOptions="Center" />
                                                            </Border>

                                                            <!-- TEMPO -->
                                                            <Border Grid.Column="2"
                                                                    StrokeShape="RoundRectangle 4"
                                                                    StrokeThickness="0"
                                                                    BackgroundColor="#262626"
                                                                    Padding="4,2">
                                                                <Label Text="{Binding TempoDisplay}"
                                                                       TextColor="{StaticResource TextMutedDark}"
                                                                       FontSize="12"
                                                                       HorizontalOptions="Center"
                                                                       VerticalOptions="Center" />
                                                            </Border>

                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Delete workout button -->
                    <Button Text="Delete Workout"
                            Command="{Binding DeleteWorkoutCommand}"
                            BackgroundColor="#C62828"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="12"
                            HeightRequest="52"
                            Margin="0,20,0,0" />

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>

</ContentPage>
