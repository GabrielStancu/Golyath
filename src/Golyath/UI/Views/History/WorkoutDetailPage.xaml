<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Golyath.UI.ViewModels.History"
             xmlns:dto="clr-namespace:Golyath.Application.DTOs;assembly=Golyath"
             x:Class="Golyath.UI.Views.History.WorkoutDetailPage"
             x:DataType="vm:WorkoutDetailViewModel"
             Title="Workout"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}">

    <Grid>
        <!-- Loading -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Accent}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

        <!-- Not found -->
        <VerticalStackLayout IsVisible="{Binding NotFound}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="8">
            <Label Text="Workout not found"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#777777, Dark=#888888}" />
        </VerticalStackLayout>

        <!-- Detail content -->
        <ScrollView IsVisible="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}">
            <VerticalStackLayout Padding="16" Spacing="14"
                                 IsVisible="{Binding NotFound, Converter={StaticResource InvertBoolConverter}}">

                <!-- Header card -->
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AppLightSurface}, Dark={StaticResource AppDarkSurface}}"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">

                        <!-- Name + date -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Detail.DisplayName}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#111111, Dark=White}" />
                            <Label Text="{Binding Detail.DateFormatted}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />
                        </VerticalStackLayout>

                        <!-- Duration -->
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0"
                                   Text="⏱"
                                   FontSize="16"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding Detail.DurationFormatted}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Accent}"
                                   VerticalOptions="Center"
                                   Margin="6,0,0,0" />
                        </Grid>

                        <!-- Tags -->
                        <FlexLayout BindableLayout.ItemsSource="{Binding Detail.TagNames}"
                                    IsVisible="{Binding Detail.TagNames.Count, Converter={StaticResource IsNotZeroConverter}}"
                                    Wrap="Wrap"
                                    Direction="Row"
                                    AlignItems="Center">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border StrokeShape="RoundRectangle 6"
                                            BackgroundColor="{StaticResource Accent}"
                                            Padding="8,3"
                                            Margin="0,0,4,4">
                                        <Label Text="{Binding .}"
                                               FontSize="11"
                                               TextColor="{StaticResource AccentText}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <!-- Notes (if present) -->
                        <Label Text="{Binding Detail.Notes}"
                               IsVisible="{Binding Detail.Notes, Converter={StaticResource IsNotNullConverter}}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Exercises section header -->
                <Label Text="EXERCISES"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1.2"
                       TextColor="{AppThemeBinding Light=#888888, Dark=#888888}"
                       Margin="4,0,0,0" />

                <!-- Exercise cards -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detail.Exercises}"
                                     Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:WorkoutExerciseSummaryDto">
                            <Border StrokeShape="RoundRectangle 14"
                                    Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AppLightSurface}, Dark={StaticResource AppDarkSurface}}"
                                    Padding="14,12">
                                <VerticalStackLayout Spacing="10">

                                    <!-- Exercise name + set count -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding ExerciseName}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#111111, Dark=White}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding SetsSummary}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#888888, Dark=#888888}"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <!-- Sets table header -->
                                    <Grid ColumnDefinitions="50,*,*,*" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Text="SET"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               CharacterSpacing="0.8"
                                               TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#666666}" />
                                        <Label Grid.Column="1"
                                               Text="WEIGHT × REPS"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               CharacterSpacing="0.8"
                                               TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#666666}" />
                                        <Label Grid.Column="2"
                                               Text="TEMPO"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               CharacterSpacing="0.8"
                                               TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#666666}" />
                                        <Label Grid.Column="3"
                                               Text="NOTES"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               CharacterSpacing="0.8"
                                               TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#666666}" />
                                    </Grid>

                                    <!-- Divider -->
                                    <BoxView HeightRequest="1"
                                             Color="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}" />

                                    <!-- Set rows -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}"
                                                         Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="dto:SetSummaryDto">
                                                <Grid ColumnDefinitions="50,*,*,*"
                                                      ColumnSpacing="8">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           FontSize="13"
                                                           TextColor="{AppThemeBinding Light=#555555, Dark=#999999}" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding WeightReps}"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#111111, Dark=White}" />
                                                    <Label Grid.Column="2"
                                                           Text="{Binding Tempo}"
                                                           FontSize="12"
                                                           TextColor="{AppThemeBinding Light=#777777, Dark=#888888}" />
                                                    <Label Grid.Column="3"
                                                           Text="{Binding Notes}"
                                                           FontSize="12"
                                                           TextColor="{AppThemeBinding Light=#777777, Dark=#888888}"
                                                           LineBreakMode="TailTruncation" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
