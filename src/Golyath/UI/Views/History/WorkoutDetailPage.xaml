<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Golyath.UI.ViewModels.History"
             xmlns:wvm="clr-namespace:Golyath.UI.ViewModels.Workout"
             x:Class="Golyath.UI.Views.History.WorkoutDetailPage"
             x:DataType="vm:WorkoutDetailViewModel"
             Title="Workout"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}">

    <Grid>
        <!-- Loading -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Accent}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

        <!-- Not found -->
        <VerticalStackLayout IsVisible="{Binding NotFound}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="8">
            <Label Text="Workout not found"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#777777, Dark=#888888}" />
        </VerticalStackLayout>

        <!-- Detail content -->
        <ScrollView IsVisible="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}">
            <VerticalStackLayout Padding="16" Spacing="14"
                                 IsVisible="{Binding NotFound, Converter={StaticResource InvertBoolConverter}}">

                <!-- Header card -->
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="{StaticResource AppDarkBorder}"
                        BackgroundColor="{StaticResource AppDarkSurface}"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">

                        <!-- Name + date -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Detail.DisplayName}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="{Binding Detail.DateFormatted}"
                                   FontSize="13"
                                   TextColor="#888888" />
                        </VerticalStackLayout>

                        <!-- Duration -->
                        <Label Text="{Binding Detail.DurationFormatted}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Accent}" />

                        <!-- Tags -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="TAGS"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="#666666" />
                            <FlexLayout BindableLayout.ItemsSource="{Binding Tags}"
                                        Wrap="Wrap"
                                        Direction="Row"
                                        AlignItems="Center">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="wvm:TagChipViewModel">
                                        <Border StrokeShape="RoundRectangle 8"
                                                BackgroundColor="#1A3020"
                                                Stroke="#2D5C3A"
                                                StrokeThickness="1"
                                                Padding="8,3"
                                                Margin="0,0,6,6">
                                            <HorizontalStackLayout Spacing="5">
                                                <Label Text="{Binding Name}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Accent}"
                                                       VerticalOptions="Center" />
                                                <Label Text="x"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light=#888888, Dark=#888888}"
                                                       VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding RemoveCommand}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <Button Text="+ Add Tag"
                                    Command="{Binding AddTagCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#AAAAAA"
                                    BorderColor="#444444"
                                    BorderWidth="1"
                                    CornerRadius="6"
                                    FontSize="12"
                                    Padding="10,4"
                                    HorizontalOptions="Start" />
                        </VerticalStackLayout>

                        <!-- Workout notes -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="WORKOUT NOTES"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="#666666" />
                            <Editor Text="{Binding EditableNotes, Mode=TwoWay}"
                                    Placeholder="Add workout notes..."
                                    PlaceholderColor="#555555"
                                    TextColor="#CCCCCC"
                                    BackgroundColor="#2A2A2A"
                                    FontSize="13"
                                    MinimumHeightRequest="60"
                                    AutoSize="TextChanges" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Exercises section header -->
                <Label Text="EXERCISES"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1.2"
                       TextColor="{AppThemeBinding Light=#888888, Dark=#888888}"
                       Margin="4,0,0,0" />

                <!-- Exercise cards — bound to editable HistoryExerciseViewModel collection -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}"
                                     Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryExerciseViewModel">
                            <Border StrokeShape="RoundRectangle 14"
                                    Stroke="{StaticResource AppDarkBorder}"
                                    BackgroundColor="{StaticResource AppDarkSurface}"
                                    Padding="14,12">
                                <VerticalStackLayout Spacing="10">

                                    <!-- Exercise name + set count -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding ExerciseName}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="White" />
                                        <Label Grid.Column="1"
                                               Text="{Binding SetsSummary}"
                                               FontSize="12"
                                               TextColor="#888888"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <!-- Exercise notes (editable) -->
                                    <Entry Text="{Binding ExerciseNotes, Mode=TwoWay}"
                                           Placeholder="Exercise notes..."
                                           PlaceholderColor="#555555"
                                           TextColor="#CCCCCC"
                                           BackgroundColor="#2A2A2A"
                                           FontSize="12" />

                                    <!-- Sets column header -->
                                    <Grid ColumnDefinitions="40,*,*,70" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Text="SET"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               CharacterSpacing="0.8"
                                               TextColor="#666666" />
                                        <Label Grid.Column="1"
                                               Text="WEIGHT"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               CharacterSpacing="0.8"
                                               TextColor="#666666" />
                                        <Label Grid.Column="2"
                                               Text="REPS"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               CharacterSpacing="0.8"
                                               TextColor="#666666" />
                                        <Label Grid.Column="3"
                                               Text="TEMPO"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               CharacterSpacing="0.8"
                                               TextColor="#666666" />
                                    </Grid>

                                    <!-- Divider -->
                                    <BoxView HeightRequest="1"
                                             Color="{StaticResource AppDarkBorder}" />

                                    <!-- Set rows (editable) -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}"
                                                         Spacing="4">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:HistorySetViewModel">
                                                <VerticalStackLayout Spacing="2">

                                                    <!-- Set number + editable weight/reps/tempo -->
                                                    <Grid ColumnDefinitions="40,*,*,70"
                                                          ColumnSpacing="8">
                                                        <Label Grid.Column="0"
                                                               Text="{Binding SetNumber, StringFormat='Set {0}'}"
                                                               FontSize="12"
                                                               VerticalOptions="Center"
                                                               TextColor="#999999" />
                                                        <Entry Grid.Column="1"
                                                               Text="{Binding WeightText, Mode=TwoWay}"
                                                               Keyboard="Numeric"
                                                               Placeholder="0"
                                                               PlaceholderColor="#555555"
                                                               TextColor="White"
                                                               BackgroundColor="#2A2A2A"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               HeightRequest="36" />
                                                        <Entry Grid.Column="2"
                                                               Text="{Binding RepsText, Mode=TwoWay}"
                                                               Keyboard="Numeric"
                                                               Placeholder="0"
                                                               PlaceholderColor="#555555"
                                                               TextColor="White"
                                                               BackgroundColor="#2A2A2A"
                                                               FontSize="13"
                                                               HeightRequest="36" />
                                                        <Border Grid.Column="3"
                                                               StrokeShape="RoundRectangle 6"
                                                               Stroke="Transparent"
                                                               BackgroundColor="#2A2A2A"
                                                               HeightRequest="36"
                                                               Padding="0">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding SelectTempoCommand}" />
                                                            </Border.GestureRecognizers>
                                                            <Label Text="{Binding TempoDisplay}"
                                                                   TextColor="#888888"
                                                                   FontSize="12"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center"
                                                                   HorizontalTextAlignment="Center" />
                                                        </Border>
                                                    </Grid>

                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Delete workout button -->
                <Button Text="Delete Workout"
                        Command="{Binding DeleteWorkoutCommand}"
                        BackgroundColor="#C62828"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="12"
                        HeightRequest="52"
                        Margin="0,20,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
