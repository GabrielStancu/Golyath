<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Golyath.UI.ViewModels.Settings"
             x:Class="Golyath.UI.Views.Settings.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- PREFERENCES SECTION                                        -->
            <!-- ══════════════════════════════════════════════════════════ -->

            <!-- ── Section Header ──────────────────────────────────────── -->
            <Label Text="PREFERENCES"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#888888"
                   Margin="4,8,0,0" />

            <!-- ── Weight Unit Card ────────────────────────────────────── -->
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    StrokeShape="RoundRectangle 12">
                <Border.Shadow>
                    <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.15" />
                </Border.Shadow>
                <VerticalStackLayout Padding="16" Spacing="12">

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="⚖️"
                               FontSize="22"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Weight Unit"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                            <Label Text="Choose your preferred unit for logging weights"
                                   FontSize="13"
                                   TextColor="#888888" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="kg"
                                CornerRadius="10"
                                HeightRequest="44"
                                FontSize="14"
                                Command="{Binding SelectMetricCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsMetricSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                    <Setter Property="TextColor" Value="{StaticResource AccentText}" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding IsMetricSelected}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EEEEEE, Dark=#2A2A2A}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#555555, Dark=#AAAAAA}" />
                                    <Setter Property="FontAttributes" Value="None" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1"
                                Text="lb"
                                CornerRadius="10"
                                HeightRequest="44"
                                FontSize="14"
                                Command="{Binding SelectImperialCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsImperialUnit}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                    <Setter Property="TextColor" Value="{StaticResource AccentText}" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding IsImperialUnit}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EEEEEE, Dark=#2A2A2A}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#555555, Dark=#AAAAAA}" />
                                    <Setter Property="FontAttributes" Value="None" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- ── Rest Timer Card ─────────────────────────────────────── -->
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    StrokeShape="RoundRectangle 12">
                <Border.Shadow>
                    <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.15" />
                </Border.Shadow>
                <VerticalStackLayout Padding="16" Spacing="12">

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="⏱️"
                               FontSize="22"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Default Rest Timer"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                            <Label Text="Auto-starts after each logged set"
                                   FontSize="13"
                                   TextColor="#888888" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <Border StrokeShape="RoundRectangle 10"
                            Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#333333}"
                            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                            Padding="14,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRestTimerTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding SelectedRestTimerLabel}"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="&#xE5CF;"
                                   FontFamily="MaterialIcons"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light=#888888, Dark=#666666}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- DATA & BACKUP SECTION                                      -->
            <!-- ══════════════════════════════════════════════════════════ -->

            <!-- ── Section Header ──────────────────────────────────────── -->
            <Label Text="DATA &amp; BACKUP"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#888888"
                   Margin="4,8,0,0" />

            <!-- ── Export Card ─────────────────────────────────────────── -->
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    StrokeShape="RoundRectangle 12">
                <Border.Shadow>
                    <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.15" />
                </Border.Shadow>
                <VerticalStackLayout Padding="16" Spacing="10">

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="&#xE2C3;"
                               FontFamily="MaterialIcons"
                               FontSize="22"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Export Data"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                            <Label Text="Save a backup of all your workouts and data"
                                   FontSize="13"
                                   TextColor="#888888" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <Button Text="Export"
                            Command="{Binding ExportDataCommand}"
                            BackgroundColor="{StaticResource Accent}"
                            TextColor="Black"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            IsEnabled="{Binding IsNotBusy}"
                            HorizontalOptions="Start"
                            Padding="24,10" />

                </VerticalStackLayout>
            </Border>

            <!-- ── Import Card ─────────────────────────────────────────── -->
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    StrokeShape="RoundRectangle 12">
                <Border.Shadow>
                    <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.15" />
                </Border.Shadow>
                <VerticalStackLayout Padding="16" Spacing="10">

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="&#xE2C4;"
                               FontFamily="MaterialIcons"
                               FontSize="22"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Import Data"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                            <Label Text="Restore from a previous backup file"
                                   FontSize="13"
                                   TextColor="#888888" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <Button Text="Import"
                            Command="{Binding ImportDataCommand}"
                            BackgroundColor="{StaticResource Accent}"
                            TextColor="Black"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            IsEnabled="{Binding IsNotBusy}"
                            HorizontalOptions="Start"
                            Padding="24,10" />

                </VerticalStackLayout>
            </Border>

            <!-- ── Activity Indicator ──────────────────────────────────── -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Accent}"
                               HorizontalOptions="Center"
                               Margin="0,8,0,0" />

            <!-- ── Status Message ──────────────────────────────────────── -->
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatus}"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"
                   Margin="0,4,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
