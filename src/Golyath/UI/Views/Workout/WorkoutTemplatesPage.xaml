<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Golyath.UI.ViewModels.Workout"
             xmlns:dto="clr-namespace:Golyath.Application.DTOs;assembly=Golyath"
             x:Class="Golyath.UI.Views.Workout.WorkoutTemplatesPage"
             x:DataType="vm:WorkoutTemplatesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Header panel with bottom-rounded corners ─────────────────── -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceLight}, Dark={StaticResource CardSurfaceDark}}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,20,20"
                Padding="16,16,16,20">
            <VerticalStackLayout Spacing="2">
                <Label Text="Workouts"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Label Text="Your workout templates"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </VerticalStackLayout>
        </Border>

        <!-- ── Content ──────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Accent}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

            <ScrollView IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}">
                <VerticalStackLayout Padding="16" Spacing="12">

                    <!-- ── Empty state ──────────────────────────────────── -->
                    <VerticalStackLayout IsVisible="{Binding HasNoWorkouts}"
                                         Spacing="12"
                                         Padding="0,48,0,0"
                                         HorizontalOptions="Center">
                        <Label Text="🏋️"
                               FontSize="56"
                               HorizontalOptions="Center" />
                        <Label Text="No Workouts Yet"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="Start your first workout from the Dashboard, and it will appear here as a template."
                               FontSize="14"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               MaximumWidthRequest="280" />
                    </VerticalStackLayout>

                    <!-- ── Recent workout templates ─────────────────────── -->
                    <Label Text="PREVIOUS WORKOUTS"
                           IsVisible="{Binding HasWorkouts}"
                           Style="{StaticResource SectionHeader}"
                           Margin="4,4,0,0" />

                    <VerticalStackLayout IsVisible="{Binding HasWorkouts}"
                                         Spacing="10"
                                         BindableLayout.ItemsSource="{Binding RecentWorkouts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:WorkoutHistorySummaryDto">
                                <Border Style="{StaticResource CardBorder}"
                                        Padding="14,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutTemplatesViewModel}}, Path=RepeatWorkoutCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <Label Text="{Binding DisplayName}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                            <HorizontalStackLayout Spacing="12">
                                                <Label FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding ExerciseCount}" />
                                                            <Span Text=" exercises" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label Text="{Binding DateFormatted}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1"
                                               Text="›"
                                               FontSize="22"
                                               TextColor="{StaticResource Accent}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="80" Color="Transparent" />

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- ── Start Free Workout Button ───────────────────────────────── -->
        <Button Grid.Row="2"
                Text="START FREE WORKOUT"
                Command="{Binding StartFreeWorkoutCommand}"
                Style="{StaticResource AccentButton}"
                Margin="16,8,16,16" />

    </Grid>
</ContentPage>
