<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Golyath.UI.ViewModels.Workout"
             xmlns:dto="clr-namespace:Golyath.Application.DTOs;assembly=Golyath"
             xmlns:controls="clr-namespace:Golyath.UI.Controls"
             x:Class="Golyath.UI.Views.Workout.WorkoutTemplatesPage"
             x:DataType="vm:WorkoutTemplatesViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Header: same style as History ──────────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,16,16,12">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="YOUR ROUTINES"
                       FontSize="11"
                       CharacterSpacing="1.5"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                <Label Text="Train"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <!-- Gold accent underline -->
                <BoxView WidthRequest="40"
                         HeightRequest="3"
                         CornerRadius="2"
                         Color="{StaticResource Accent}"
                         HorizontalOptions="Start"
                         Margin="0,2,0,0" />
            </VerticalStackLayout>
            <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 4"
                    StrokeThickness="1.5"
                    Stroke="{StaticResource Accent}"
                    BackgroundColor="Transparent"
                    WidthRequest="40"
                    HeightRequest="40"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NewRoutineCommand}" />
                </Border.GestureRecognizers>
                <Label Text="+"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Accent}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- ── Content ──────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Accent}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

            <ScrollView IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}">
                <VerticalStackLayout Padding="16,0,16,16" Spacing="12">

                    <!-- ── Empty state ──────────────────────────────────── -->
                    <VerticalStackLayout IsVisible="{Binding HasNoRoutines}"
                                         Spacing="12"
                                         Padding="0,48,0,0"
                                         HorizontalOptions="Center">
                        <Label Text="&#xEB43;"
                               FontFamily="MaterialIcons"
                               FontSize="56"
                               HorizontalOptions="Center" />
                        <Label Text="No Routines Yet"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="Create your first routine to start training with structure."
                               FontSize="14"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               MaximumWidthRequest="280" />
                        <Button Text="+ NEW ROUTINE"
                                Command="{Binding NewRoutineCommand}"
                                Style="{StaticResource AccentButton}"
                                Margin="0,8,0,0"
                                HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- ── Routines list ────────────────────────────────── -->
                    <VerticalStackLayout IsVisible="{Binding HasRoutines}"
                                         Spacing="10"
                                         BindableLayout.ItemsSource="{Binding Routines}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:RoutineSummaryDto">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems Mode="Execute">
                                            <SwipeItem IconImageSource="{FontImageSource FontFamily=MaterialIcons, Glyph=&#xE872;, Color=White, Size=24}"
                                                       Text="Delete"
                                                       BackgroundColor="#EF5350"
                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutTemplatesViewModel}}, Path=DeleteRoutineCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Border Style="{StaticResource CardBorder}"
                                            Padding="14,12">
                                        <!-- Card tap → EDIT routine -->
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutTemplatesViewModel}}, Path=EditRoutineCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="6,*,Auto" ColumnSpacing="12">
                                            <!-- Category color bar -->
                                            <BoxView Grid.Column="0"
                                                     CornerRadius="3"
                                                     WidthRequest="6"
                                                     Color="{Binding CategoryHexColor}"
                                                     VerticalOptions="Fill" />
                                            <!-- Info -->
                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextPrimaryDark}" />
                                                <HorizontalStackLayout Spacing="12">
                                                    <Label Text="{Binding ExerciseLabel}"
                                                           FontSize="12"
                                                           TextColor="{StaticResource TextSecondaryDark}" />
                                                    <Label Text="{Binding DurationLabel}"
                                                           FontSize="12"
                                                           TextColor="{StaticResource TextMutedDark}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                            <!-- Play button (outline) → starts workout -->
                                            <Border Grid.Column="2"
                                                    StrokeShape="RoundRectangle 4"
                                                    StrokeThickness="1.5"
                                                    Stroke="{StaticResource Accent}"
                                                    BackgroundColor="Transparent"
                                                    WidthRequest="44"
                                                    HeightRequest="44"
                                                    VerticalOptions="Center">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutTemplatesViewModel}}, Path=StartRoutineCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="▶"
                                                       FontSize="16"
                                                       TextColor="{StaticResource Accent}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       Margin="2,0,0,0" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="96" Color="Transparent" />

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- ── Custom bottom nav bar (overlays content at bottom) ──────── -->
        <controls:BottomNavBar Grid.Row="1"
                               ActiveTab="train"
                               VerticalOptions="End" />

    </Grid>
</ContentPage>
