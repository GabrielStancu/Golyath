<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Golyath.UI.ViewModels.Workout"
             xmlns:controls="clr-namespace:Golyath.UI.Controls"
             x:Class="Golyath.UI.Views.Workout.ActiveWorkoutPage"
             x:DataType="vm:ActiveWorkoutViewModel"
             BackgroundColor="{StaticResource AppDarkBg}"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <!-- Row 0 Â· Header (always dark)                                      -->
        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource AppDarkBg}"
              Padding="16,14,16,0"
              RowDefinitions="Auto,Auto,Auto">

            <!-- Title row: workout name + END button -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  Margin="0,0,0,6">
                <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                    <Label Text="{Binding WorkoutTitle}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>

                <!-- END button: red outline -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 4"
                        Stroke="#EF5350"
                        StrokeThickness="1.5"
                        BackgroundColor="Transparent"
                        Padding="14,8"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding EndWorkoutCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="END"
                           FontSize="12"
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           TextColor="#EF5350"
                           VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Elapsed timer + effort curve -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,Auto"
                  Margin="0,0,0,10">
                <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                    <Label Text="ELAPSED"
                           FontSize="9"
                           CharacterSpacing="1.2"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextMutedDark}" />
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding ElapsedTime}"
                               FontSize="34"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Accent}"
                               FontFamily="InterRegular"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Text="EFFORT"
                           FontSize="9"
                           CharacterSpacing="1.2"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextMutedDark}"
                           HorizontalOptions="Center" />
                    <controls:EffortCurveChart Points="{Binding EffortPoints}"
                                               WidthRequest="80"
                                               HeightRequest="32"
                                               VerticalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- Progress bar row: label Â· bar Â· count -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10"
                  Padding="0,0,0,12">
                <Label Grid.Column="0"
                       Text="PROGRESS"
                       FontSize="9"
                       CharacterSpacing="1.2"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextMutedDark}"
                       VerticalOptions="Center" />
                <controls:ProgressFillView Grid.Column="1"
                                          Progress="{Binding ProgressFraction}"
                                          HeightRequest="4"
                                          VerticalOptions="Center" />
                <Label Grid.Column="2"
                       Text="{Binding ProgressText}"
                       FontSize="9"
                       CharacterSpacing="0.5"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Accent}"
                       VerticalOptions="Center" />
            </Grid>
        </Grid>

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <!-- Row 1 Â· Exercise list                                             -->
        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,12,16,24" Spacing="12">

                <!-- Activity indicator -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Accent}"
                                   HorizontalOptions="Center"
                                   Margin="0,32" />

                <!-- â”€â”€ Exercise cards â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkoutExerciseViewModel">

                            <Border BackgroundColor="{StaticResource CardSurfaceDark}"
                                    Stroke="{StaticResource CardBorderDark}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 4"
                                    Padding="14,12">
                                <VerticalStackLayout Spacing="10">

                                    <!-- Exercise header: name + PR badge + remove -->
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Text="{Binding ExerciseName}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               VerticalOptions="Center" />

                                        <!-- PR badge (visible only when beating history) -->
                                        <Border Grid.Column="1"
                                                IsVisible="{Binding ShowPrBadge}"
                                                StrokeShape="RoundRectangle 4"
                                                StrokeThickness="0"
                                                BackgroundColor="{StaticResource Accent}"
                                                Padding="7,3"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding PrBadgeText}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#111111" />
                                        </Border>

                                        <!-- Remove exercise -->
                                        <Label Grid.Column="2"
                                               Text="&#xE5CD;"
                                               FontFamily="MaterialIcons"
                                               FontSize="18"
                                               TextColor="{StaticResource TextMutedDark}"
                                               VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding RemoveCommand}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>

                                    <!-- Column headers: KG Â· REPS Â· TEMPO Â· PREV Â· âś“ -->
                                    <Grid ColumnDefinitions="*,56,70,60,36"
                                          ColumnSpacing="6"
                                          Padding="0,0,0,2">
                                        <Label Grid.Column="0"
                                               Text="KG"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               CharacterSpacing="1"
                                               TextColor="{StaticResource TextMutedDark}" />
                                        <Label Grid.Column="1"
                                               Text="REPS"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               CharacterSpacing="1"
                                               TextColor="{StaticResource TextMutedDark}"
                                               HorizontalOptions="Center" />
                                        <Label Grid.Column="2"
                                               Text="TEMPO"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               CharacterSpacing="1"
                                               TextColor="{StaticResource TextMutedDark}"
                                               HorizontalOptions="Center" />
                                        <Label Grid.Column="3"
                                               Text="PREV"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               CharacterSpacing="1"
                                               TextColor="{StaticResource TextMutedDark}"
                                               HorizontalOptions="Center" />
                                    </Grid>

                                    <!-- â”€â”€ Set rows â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}"
                                                         Spacing="5">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WorkoutSetViewModel">

                                                <SwipeView>
                                                    <SwipeView.LeftItems>
                                                        <SwipeItems>
                                                            <SwipeItem Text="Delete"
                                                                       BackgroundColor="#C62828"
                                                                       Command="{Binding RemoveCommand}" />
                                                        </SwipeItems>
                                                    </SwipeView.LeftItems>
                                                    <SwipeView.RightItems>
                                                        <SwipeItems>
                                                            <SwipeItem Text="Duplicate"
                                                                       BackgroundColor="#1A3A5C"
                                                                       Command="{Binding DuplicateCommand}" />
                                                        </SwipeItems>
                                                    </SwipeView.RightItems>

                                                    <!-- Row shell: subtle highlight when focused -->
                                                    <Border StrokeShape="RoundRectangle 4"
                                                            BackgroundColor="#1A1A1A"
                                                            StrokeThickness="0"
                                                            Padding="8,6">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding FocusCommand}" />
                                                        </Border.GestureRecognizers>
                                                        <Border.Triggers>
                                                            <DataTrigger TargetType="Border"
                                                                         Binding="{Binding IsActive}"
                                                                         Value="True">
                                                                <Setter Property="BackgroundColor" Value="#252525" />
                                                            </DataTrigger>
                                                        </Border.Triggers>

                                                        <Grid ColumnDefinitions="*,56,70,60,36"
                                                              ColumnSpacing="6">

                                                            <!-- KG: input cell (bordered), Entry when active, Label otherwise -->
                                                            <Border Grid.Column="0"
                                                                    StrokeShape="RoundRectangle 3"
                                                                    Stroke="#2A2A2A"
                                                                    StrokeThickness="1"
                                                                    BackgroundColor="Transparent"
                                                                    Padding="4,0">
                                                                <Border.Triggers>
                                                                    <DataTrigger TargetType="Border"
                                                                                 Binding="{Binding IsActive}"
                                                                                 Value="True">
                                                                        <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                                                    </DataTrigger>
                                                                </Border.Triggers>
                                                                <Grid>
                                                                    <Entry IsVisible="{Binding IsActive}"
                                                                           Text="{Binding WeightText}"
                                                                           Keyboard="Numeric"
                                                                           BackgroundColor="Transparent"
                                                                           TextColor="{StaticResource Accent}"
                                                                           FontSize="15"
                                                                           FontAttributes="Bold"
                                                                           HorizontalTextAlignment="Start" />
                                                                    <Label IsVisible="{Binding IsActive, Converter={StaticResource InvertBoolConverter}}"
                                                                           Text="{Binding WeightText}"
                                                                           FontSize="15"
                                                                           FontAttributes="Bold"
                                                                           VerticalOptions="Center">
                                                                        <Label.Triggers>
                                                                            <DataTrigger TargetType="Label"
                                                                                         Binding="{Binding IsCompleted}"
                                                                                         Value="True">
                                                                                <Setter Property="TextColor" Value="White" />
                                                                            </DataTrigger>
                                                                            <DataTrigger TargetType="Label"
                                                                                         Binding="{Binding IsCompleted}"
                                                                                         Value="False">
                                                                                <Setter Property="TextColor" Value="#888888" />
                                                                            </DataTrigger>
                                                                        </Label.Triggers>
                                                                    </Label>
                                                                </Grid>
                                                            </Border>

                                                            <!-- REPS: input cell (bordered), Entry when active, Label otherwise -->
                                                            <Border Grid.Column="1"
                                                                    StrokeShape="RoundRectangle 3"
                                                                    Stroke="#2A2A2A"
                                                                    StrokeThickness="1"
                                                                    BackgroundColor="Transparent"
                                                                    Padding="4,0">
                                                                <Border.Triggers>
                                                                    <DataTrigger TargetType="Border"
                                                                                 Binding="{Binding IsActive}"
                                                                                 Value="True">
                                                                        <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                                                    </DataTrigger>
                                                                </Border.Triggers>
                                                                <Grid>
                                                                    <Entry IsVisible="{Binding IsActive}"
                                                                           Text="{Binding RepsText}"
                                                                           Keyboard="Numeric"
                                                                           BackgroundColor="Transparent"
                                                                           TextColor="{StaticResource Accent}"
                                                                           FontSize="15"
                                                                           FontAttributes="Bold"
                                                                           HorizontalTextAlignment="Center" />
                                                                    <Label IsVisible="{Binding IsActive, Converter={StaticResource InvertBoolConverter}}"
                                                                           Text="{Binding RepsText}"
                                                                           FontSize="15"
                                                                           FontAttributes="Bold"
                                                                           HorizontalOptions="Center"
                                                                           VerticalOptions="Center">
                                                                        <Label.Triggers>
                                                                            <DataTrigger TargetType="Label"
                                                                                         Binding="{Binding IsCompleted}"
                                                                                         Value="True">
                                                                                <Setter Property="TextColor" Value="White" />
                                                                            </DataTrigger>
                                                                            <DataTrigger TargetType="Label"
                                                                                         Binding="{Binding IsCompleted}"
                                                                                         Value="False">
                                                                                <Setter Property="TextColor" Value="#888888" />
                                                                            </DataTrigger>
                                                                        </Label.Triggers>
                                                                    </Label>
                                                                </Grid>
                                                            </Border>

                                                            <!-- TEMPO: tappable in all states -->
                                                            <Border Grid.Column="2"
                                                                    StrokeShape="RoundRectangle 4"
                                                                    StrokeThickness="0"
                                                                    BackgroundColor="#262626"
                                                                    Padding="4,0">
                                                                <Border.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding SelectTempoCommand}" />
                                                                </Border.GestureRecognizers>
                                                                <Label Text="{Binding TempoDisplay}"
                                                                       TextColor="{StaticResource TextMutedDark}"
                                                                       FontSize="12"
                                                                       HorizontalOptions="Center"
                                                                       VerticalOptions="Center" />
                                                            </Border>

                                                            <!-- PREV: always a label -->
                                                            <Label Grid.Column="3"
                                                                   Text="{Binding PrevDisplay}"
                                                                   TextColor="{StaticResource TextMutedDark}"
                                                                   FontSize="12"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center" />

                                                            <!-- Completed: gold-filled checkbox with black tick -->
                                                            <Border Grid.Column="4"
                                                                    StrokeShape="RoundRectangle 4"
                                                                    Stroke="{StaticResource Accent}"
                                                                    StrokeThickness="1.5"
                                                                    BackgroundColor="{StaticResource Accent}"
                                                                    WidthRequest="28"
                                                                    HeightRequest="28"
                                                                    HorizontalOptions="Center"
                                                                    VerticalOptions="Center"
                                                                    IsVisible="{Binding IsCompleted}">
                                                                <Label Text="&#xE5CA;"
                                                                       FontFamily="MaterialIcons"
                                                                       FontSize="16"
                                                                       TextColor="#111111"
                                                                       HorizontalOptions="Center"
                                                                       VerticalOptions="Center" />
                                                            </Border>

                                                            <!-- Incomplete: gold-outline empty checkbox (tappable) -->
                                                            <Border Grid.Column="4"
                                                                    StrokeShape="RoundRectangle 4"
                                                                    Stroke="{StaticResource Accent}"
                                                                    StrokeThickness="1.5"
                                                                    BackgroundColor="Transparent"
                                                                    WidthRequest="28"
                                                                    HeightRequest="28"
                                                                    HorizontalOptions="Center"
                                                                    VerticalOptions="Center"
                                                                    IsVisible="{Binding IsCompleted, Converter={StaticResource InvertBoolConverter}}">
                                                                <Border.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding CompleteSetCommand}" />
                                                                </Border.GestureRecognizers>
                                                            </Border>

                                                        </Grid>
                                                    </Border>
                                                </SwipeView>

                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <!-- + ADD SET outline button -->
                                    <Border StrokeShape="RoundRectangle 4"
                                            Stroke="{StaticResource CardBorderDark}"
                                            StrokeThickness="1"
                                            BackgroundColor="Transparent"
                                            Padding="0,10">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding AddSetCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="+ ADD SET"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               CharacterSpacing="0.8"
                                               TextColor="{StaticResource TextMutedDark}"
                                               HorizontalOptions="Center" />
                                    </Border>

                                </VerticalStackLayout>
                            </Border>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- + ADD EXERCISE outline button -->
                <Border StrokeShape="RoundRectangle 4"
                        Stroke="{StaticResource Accent}"
                        StrokeThickness="1.5"
                        BackgroundColor="Transparent"
                        Padding="0,14"
                        Margin="0,4,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RequestAddExerciseCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="+ ADD EXERCISE"
                           FontSize="13"
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           TextColor="{StaticResource Accent}"
                           HorizontalOptions="Center" />
                </Border>

                <!-- Empty state hint -->
                <Label Text="Tap &quot;+ ADD EXERCISE&quot; to start your workout"
                       FontSize="13"
                       TextColor="{StaticResource TextMutedDark}"
                       HorizontalOptions="Center"
                       Margin="0,8,0,0"
                       IsVisible="False">
                    <Label.Triggers>
                        <MultiTrigger TargetType="Label">
                            <MultiTrigger.Conditions>
                                <BindingCondition Binding="{Binding IsBusy}" Value="False" />
                                <BindingCondition Binding="{Binding TotalExerciseCount}" Value="0" />
                            </MultiTrigger.Conditions>
                            <Setter Property="IsVisible" Value="True" />
                        </MultiTrigger>
                    </Label.Triggers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <!-- Row 2 Â· Bottom bar (rest timer + LOG CTA)                        -->
        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <Grid Grid.Row="2"
              BackgroundColor="{StaticResource AppDarkBg}"
              RowDefinitions="Auto,Auto">

            <!-- Rest timer strip -->
            <Grid Grid.Row="0"
                  IsVisible="{Binding IsRestTimerVisible}"
                  BackgroundColor="#171717"
                  RowDefinitions="Auto,3"
                  Padding="16,10,16,0">
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto,*,Auto">
                    <!-- Skip button -->
                    <Label Grid.Column="0"
                           Text="&#xE037;"
                           FontFamily="MaterialIcons"
                           FontSize="22"
                           TextColor="{StaticResource TextMutedDark}"
                           VerticalOptions="Center"
                           Margin="0,0,10,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SkipRestCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <!-- Label -->
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="REST TIMER"
                               FontSize="9"
                               CharacterSpacing="1.2"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextMutedDark}" />
                        <Label Text="{Binding RestTimeDisplay}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Accent}" />
                    </VerticalStackLayout>
                    <!-- Target -->
                    <Label Grid.Column="2"
                           TextColor="{StaticResource TextMutedDark}"
                           FontSize="12"
                           VerticalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding RestSecondsRemaining}" />
                                <Span Text="s" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Grid>
                <!-- Gold progress bar (shrinks as timer counts down) -->
                <ProgressBar Grid.Row="1"
                             Progress="{Binding RestProgressFraction}"
                             ProgressColor="{StaticResource Accent}"
                             BackgroundColor="#2A2A2A"
                             Margin="0,8,0,0" />
            </Grid>

            <!-- LOG SET & CONTINUE CTA -->
            <Border Grid.Row="1"
                    StrokeShape="RoundRectangle 4"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource Accent}"
                    Padding="0,15"
                    Margin="16,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding LogAndContinueCommand}" />
                </Border.GestureRecognizers>
                <Label Text="LOG SET &amp; CONTINUE"
                       FontSize="14"
                       FontAttributes="Bold"
                       CharacterSpacing="0.8"
                       TextColor="#111111"
                       HorizontalOptions="Center" />
            </Border>
        </Grid>

    </Grid>
</ContentPage>
