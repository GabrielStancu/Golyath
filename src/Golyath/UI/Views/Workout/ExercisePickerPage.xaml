<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Golyath.UI.ViewModels.Workout"
             xmlns:entities="clr-namespace:Golyath.Core.Entities;assembly=Golyath"
             x:Class="Golyath.UI.Views.Workout.ExercisePickerPage"
             x:Name="ThisPage"
             x:DataType="vm:ExercisePickerViewModel"
             Title="Add Exercise"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Header panel with search & filters ─────────────────────────── -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceLight}, Dark={StaticResource CardSurfaceDark}}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,20,20"
                Padding="16,16,16,12">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="&#xE5CB;"
                           FontFamily="MaterialIcons"
                           FontSize="28"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark=White}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackClicked" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Grid.Column="1"
                           Text="Add Exercise"
                           FontSize="22"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                </Grid>

                <!-- Search bar -->
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}"
                        Padding="4,0">
                    <SearchBar Text="{Binding SearchQuery}"
                               Placeholder="Search exercises…"
                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark=#666666}"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark=White}"
                               BackgroundColor="Transparent"
                               CancelButtonColor="{StaticResource Accent}" />
                </Border>

                <!-- Filters row -->
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}"
                            Padding="14,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMuscleFilterTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding SelectedMuscleGroup}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark=White}"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="&#xE5CF;"
                                   FontFamily="MaterialIcons"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark=#888888}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}"
                            Padding="14,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEquipmentFilterTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding SelectedEquipment}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark=White}"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="&#xE5CF;"
                                   FontFamily="MaterialIcons"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark=#888888}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Button Grid.Column="2"
                            Text="&#xE5CD;"
                            FontFamily="MaterialIcons"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark=#888888}"
                            FontSize="15"
                            Padding="8,4"
                            VerticalOptions="Center"
                            Command="{Binding ClearFiltersCommand}"
                            ToolTipProperties.Text="Clear filters" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Loading indicator -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Accent}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

        <!-- Exercise list -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Exercises}"
                        IsVisible="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="entities:Exercise">
                    <Grid Padding="16,6" ColumnDefinitions="*,Auto" ColumnSpacing="8">

                        <!-- Exercise card (tap to select) -->
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource AppDarkSurface}"
                                Stroke="{StaticResource AppDarkBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="14,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectExerciseCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Name}"
                                       TextColor="White"
                                       FontSize="15"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding PrimaryMuscle}"
                                       TextColor="{StaticResource Accent}"
                                       FontSize="12"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding SecondaryMusclesDisplay}"
                                       IsVisible="{Binding SecondaryMusclesDisplay, Converter={StaticResource IsNotEmptyStringConverter}}"
                                       TextColor="#666666"
                                       FontSize="11" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Preview button -->
                        <Button Grid.Column="1"
                                Text="&#xE88E;"
                FontFamily="MaterialIcons"
                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.PreviewExerciseCommand}"
                                CommandParameter="{Binding .}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Accent}"
                                FontSize="20"
                                FontAttributes="Bold"
                                WidthRequest="44"
                                HeightRequest="44"
                                VerticalOptions="Center"
                                Padding="0" />

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
