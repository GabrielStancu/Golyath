<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Golyath.UI.ViewModels.Dashboard"
             xmlns:controls="clr-namespace:Golyath.UI.Controls"
             x:Class="Golyath.UI.Views.Dashboard.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Dashboard"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Profile" Clicked="OnProfileClicked" Order="Primary" Priority="0" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*, Auto">

        <!-- ── Scrollable content ─────────────────────────────────────────── -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- Loading indicator -->
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource Accent}"
                                   HorizontalOptions="Center"
                                   Margin="0,32,0,0" />

                <!-- Content (hidden while loading) -->
                <VerticalStackLayout IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"
                                     Spacing="14">

                    <!-- Header ─────────────────────────────────────────── -->
                    <VerticalStackLayout Spacing="2" Padding="4,0,0,0">
                        <Label Text="{Binding Greeting}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#111111, Dark=White}" />
                        <Label Text="{Binding TodayLabel}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />
                    </VerticalStackLayout>

                    <!-- Readiness Card ──────────────────────────────────── -->
                    <Border StrokeShape="RoundRectangle 16"
                            Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AppLightSurface}, Dark={StaticResource AppDarkSurface}}"
                            Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="READINESS"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.2"
                                   TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />

                            <!-- Radial gauge with emoji overlaid in the arc opening -->
                            <Grid HeightRequest="130">
                                <controls:RadialGauge
                                    Value="{Binding ReadinessValue}"
                                    GaugeColor="{Binding ReadinessGaugeColor}"
                                    StrokeWidth="16" />
                                <Label Text="{Binding ReadinessEmoji}"
                                       FontSize="36"
                                       HorizontalOptions="Center"
                                       VerticalOptions="End"
                                       Margin="0,0,0,6" />
                            </Grid>

                            <Label Text="{Binding ReadinessLabel}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#111111, Dark=White}" />
                            <Label Text="{Binding ReadinessMessage}"
                                   FontSize="13"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#999999}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Weekly Activity Card ────────────────────────────── -->
                    <Border StrokeShape="RoundRectangle 16"
                            Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AppLightSurface}, Dark={StaticResource AppDarkSurface}}"
                            Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="THIS WEEK"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.2"
                                   TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />

                            <controls:WeeklyBarChart
                                Days="{Binding WeeklyDays}"
                                HeightRequest="96" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Last Workout Card ───────────────────────────────── -->
                    <Border StrokeShape="RoundRectangle 16"
                            Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AppLightSurface}, Dark={StaticResource AppDarkSurface}}"
                            Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="LAST WORKOUT"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.2"
                                   TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />

                            <!-- Has workout -->
                            <Grid IsVisible="{Binding HasLastWorkout}"
                                  ColumnDefinitions="*, Auto"
                                  RowDefinitions="Auto, Auto">
                                <VerticalStackLayout Grid.Column="0" Grid.RowSpan="2" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding LastWorkoutTitle}"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#111111, Dark=White}" />
                                    <Label Text="{Binding LastWorkoutDate}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />
                                </VerticalStackLayout>

                                <!-- Stat pills -->
                                <HorizontalStackLayout Grid.Column="1" Grid.Row="0" Spacing="8" VerticalOptions="Center">
                                    <Border StrokeShape="RoundRectangle 8"
                                            Stroke="Transparent"
                                            BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#252525}"
                                            Padding="10,6">
                                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                            <Label Text="{Binding LastWorkoutSets}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#111111, Dark=White}" />
                                            <Label Text="sets"
                                                   FontSize="10"
                                                   HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 8"
                                            Stroke="Transparent"
                                            BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#252525}"
                                            Padding="10,6">
                                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                            <Label Text="{Binding LastWorkoutVolume}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#111111, Dark=White}" />
                                            <Label Text="volume"
                                                   FontSize="10"
                                                   HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 8"
                                            Stroke="Transparent"
                                            BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#252525}"
                                            Padding="10,6">
                                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                            <Label Text="{Binding LastWorkoutDuration}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#111111, Dark=White}" />
                                            <Label Text="time"
                                                   FontSize="10"
                                                   HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </HorizontalStackLayout>
                            </Grid>

                            <!-- Empty state -->
                            <VerticalStackLayout IsVisible="{Binding HasNoLastWorkout}" Spacing="4">
                                <Label Text="No workouts yet"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#111111, Dark=White}" />
                                <Label Text="Start your first session to see it here."
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Suggested Focus Card ────────────────────────────── -->
                    <Border StrokeShape="RoundRectangle 16"
                            Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AppLightSurface}, Dark={StaticResource AppDarkSurface}}"
                            Padding="16">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="SUGGESTED FOCUS"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.2"
                                   TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />
                            <Label Text="{Binding SuggestionMuscle}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Accent}" />
                            <Label Text="{Binding SuggestionReason}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#999999}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Bottom spacer so FAB doesn't cover last card -->
                    <BoxView HeightRequest="8" Color="Transparent" />

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Start Workout FAB ──────────────────────────────────────────── -->
        <Button Grid.Row="1"
                Text="START WORKOUT"
                Command="{Binding StartWorkoutCommand}"
                BackgroundColor="{StaticResource Accent}"
                TextColor="{StaticResource AccentText}"
                FontAttributes="Bold"
                FontSize="15"
                CharacterSpacing="1"
                CornerRadius="14"
                HeightRequest="56"
                Margin="16,8,16,16" />

    </Grid>
</ContentPage>
