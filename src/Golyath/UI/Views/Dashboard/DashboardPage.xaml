<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Golyath.UI.ViewModels.Dashboard"
             xmlns:controls="clr-namespace:Golyath.UI.Controls"
             x:Class="Golyath.UI.Views.Dashboard.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Header panel with bottom-rounded corners ───────────────────── -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceLight}, Dark={StaticResource CardSurfaceDark}}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,20,20"
                Padding="0,0,0,8"
                ZIndex="1">

            <!-- Loading indicator -->
            <VerticalStackLayout>
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource Accent}"
                                   HorizontalOptions="Center"
                                   Margin="0,32,0,0" />

                <!-- Header: Greeting + Settings gear (hidden while loading) -->
                <Grid ColumnDefinitions="*, Auto" Padding="20,16,16,8"
                      IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Greeting}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="{Binding TodayLabel}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 22"
                            Stroke="Transparent"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}"
                            WidthRequest="44"
                            HeightRequest="44"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsClicked" />
                        </Border.GestureRecognizers>
                        <Label Text="⚙️"
                               FontSize="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- ── Scrollable content ─────────────────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Content (hidden while loading) -->
                <VerticalStackLayout IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"
                                     Spacing="16">

                    <!-- ── Readiness Gauge (Hero) ──────────────────────── -->
                    <Grid HeightRequest="220" HorizontalOptions="Center">
                        <controls:RadialGauge
                            Value="{Binding ReadinessValue}"
                            GaugeColor="{Binding ReadinessGaugeColor}"
                            IsDark="{AppThemeBinding Light=False, Dark=True}"
                            StrokeWidth="20"
                            WidthRequest="200"
                            HeightRequest="200"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                        <!-- Centered emoji + percentage overlay -->
                        <VerticalStackLayout HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="0">
                            <Label Text="{Binding ReadinessEmoji}"
                                   FontSize="40"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding ReadinessValue, StringFormat='{0:P0}'}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                    <!-- Readiness label + message below gauge -->
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center" Margin="0,-8,0,0">
                        <Label Text="{Binding ReadinessLabel}"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="{Binding ReadinessMessage}"
                               FontSize="13"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>

                    <!-- ── Last Workout Stats Row (pills) ──────────────── -->
                    <Grid ColumnDefinitions="*, *, *"
                          ColumnSpacing="10"
                          IsVisible="{Binding HasLastWorkout}">
                        <!-- Sets pill -->
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceLight}, Dark={StaticResource CardSurfaceDark}}"
                                Padding="12,10">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="{Binding LastWorkoutSets}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="Sets"
                                       FontSize="11"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            </VerticalStackLayout>
                        </Border>
                        <!-- Volume pill -->
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceLight}, Dark={StaticResource CardSurfaceDark}}"
                                Padding="12,10">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="{Binding LastWorkoutVolume}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="Volume"
                                       FontSize="11"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            </VerticalStackLayout>
                        </Border>
                        <!-- Duration pill -->
                        <Border Grid.Column="2"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceLight}, Dark={StaticResource CardSurfaceDark}}"
                                Padding="12,10">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="{Binding LastWorkoutDuration}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="Duration"
                                       FontSize="11"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- ── Weekly Activity Card ────────────────────────── -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="THIS WEEK"
                                   Style="{StaticResource SectionHeader}" />
                            <controls:WeeklyBarChart
                                Days="{Binding WeeklyDays}"
                                HeightRequest="96" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- ── Last Workout Card (compact) ─────────────────── -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="LAST WORKOUT"
                                   Style="{StaticResource SectionHeader}" />

                            <!-- Has workout -->
                            <Grid IsVisible="{Binding HasLastWorkout}"
                                  ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding LastWorkoutTitle}"
                                           Style="{StaticResource CardTitle}" />
                                    <Label Text="{Binding LastWorkoutDate}"
                                           Style="{StaticResource CardSubtitle}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="View ›"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Accent}" />
                            </Grid>

                            <!-- Empty state -->
                            <VerticalStackLayout IsVisible="{Binding HasNoLastWorkout}" Spacing="4">
                                <Label Text="No workouts yet"
                                       Style="{StaticResource CardTitle}" />
                                <Label Text="Start your first session to see it here."
                                       Style="{StaticResource CardSubtitle}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ── Suggested Focus Card ────────────────────────── -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="SUGGESTED FOCUS"
                                   Style="{StaticResource SectionHeader}" />
                            <Label Text="{Binding SuggestionMuscle}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Accent}" />
                            <Label Text="{Binding SuggestionReason}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Bottom spacer so button doesn't cover last card -->
                    <BoxView HeightRequest="8" Color="Transparent" />

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Start Workout Button ───────────────────────────────────────── -->
        <Button Grid.Row="2"
                Text="START WORKOUT"
                Command="{Binding StartWorkoutCommand}"
                Style="{StaticResource AccentButton}"
                Margin="16,8,16,16" />

    </Grid>
</ContentPage>
