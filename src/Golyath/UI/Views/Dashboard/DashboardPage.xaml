<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Golyath.UI.ViewModels.Dashboard"
             xmlns:controls="clr-namespace:Golyath.UI.Controls"
             xmlns:dto="clr-namespace:Golyath.Application.DTOs;assembly=Golyath"
             x:Class="Golyath.UI.Views.Dashboard.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Header: same style as History ──────────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,16,16,12">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="{Binding GreetingLine}"
                       FontSize="11"
                       CharacterSpacing="1.5"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                <Label Text="{Binding UserName}"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <!-- Gold accent underline -->
                <BoxView WidthRequest="40"
                         HeightRequest="3"
                         CornerRadius="2"
                         Color="{StaticResource Accent}"
                         HorizontalOptions="Start"
                         Margin="0,2,0,0" />
            </VerticalStackLayout>

            <!-- Avatar circle (tap → profile) -->
            <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 22"
                    Stroke="{StaticResource Accent}"
                    StrokeThickness="2"
                    BackgroundColor="{StaticResource Accent}"
                    WidthRequest="44"
                    HeightRequest="44"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenProfileCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{Binding UserInitial}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource AccentText}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- ── Scrollable content ─────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Accent}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
            <ScrollView IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}">
            <VerticalStackLayout Padding="16,8,16,16" Spacing="16">

                <!-- ── Hero Card (always dark theme) ───────────────────── -->
                <Border StrokeShape="RoundRectangle 4"
                        StrokeThickness="0"
                        BackgroundColor="#1E1E1E"
                        Padding="0"
                        HeightRequest="180">
                    <Grid>
                        <!-- Hatched pattern background -->
                        <controls:HatchPatternView
                            LineColor="#19FFD700"
                            LineSpacing="10"
                            LineThickness="1"
                            InputTransparent="True" />

                        <!-- Large decorative icon stamp -->
                        <Label Text="&#xEB43;"
                               FontFamily="MaterialIcons"
                               FontSize="130"
                               TextColor="#1AFFD700"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               Margin="0,0,8,0"
                               InputTransparent="True" />

                        <!-- Card content -->
                        <VerticalStackLayout Spacing="6"
                                             Padding="20,24,20,20"
                                             VerticalOptions="Center">
                            <Label Text="TODAY'S SESSION"
                                   FontSize="11"
                                   CharacterSpacing="1.2"
                                   FontAttributes="Bold"
                                   TextColor="#FFD700" />
                            <Label Text="{Binding HeroTitle}"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="{Binding HeroSubtitle}"
                                   FontSize="13"
                                   TextColor="#999999" />
                            <!-- Start Session button -->
                            <Button Text="START SESSION"
                                    Command="{Binding StartWorkoutCommand}"
                                    BackgroundColor="#FFD700"
                                    TextColor="#111111"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    CharacterSpacing="0.8"
                                    CornerRadius="4"
                                    HeightRequest="40"
                                    WidthRequest="160"
                                    HorizontalOptions="Start"
                                    Margin="0,6,0,0" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ── Stats Row (pills) ───────────────────────────────── -->
                <Grid ColumnDefinitions="*, *, *"
                      ColumnSpacing="10">
                    <!-- This Week pill -->
                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 4"
                            Stroke="Transparent"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceLight}, Dark={StaticResource CardSurfaceDark}}"
                            Padding="12,10">
                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                                <Label Text="{Binding WeeklyWorkoutCount}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       VerticalOptions="End"
                                       TextColor="{StaticResource Accent}" />
                                <Label Text="SESSIONS"
                                       FontSize="9"
                                       CharacterSpacing="0.8"
                                       VerticalOptions="End"
                                       Margin="0,0,0,4"
                                       TextColor="{StaticResource TextMutedDark}" />
                            </HorizontalStackLayout>
                            <Label Text="THIS WEEK"
                                   FontSize="9"
                                   CharacterSpacing="0.8"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource TextMutedDark}" />
                        </VerticalStackLayout>
                    </Border>
                    <!-- Volume pill -->
                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 4"
                            Stroke="Transparent"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceLight}, Dark={StaticResource CardSurfaceDark}}"
                            Padding="12,10">
                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                                <Label Text="{Binding WeeklyVolume}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       VerticalOptions="End"
                                       TextColor="{StaticResource TextPrimaryDark}" />
                                <Label Text="KG"
                                       FontSize="9"
                                       CharacterSpacing="0.8"
                                       VerticalOptions="End"
                                       Margin="0,0,0,4"
                                       TextColor="{StaticResource TextMutedDark}" />
                            </HorizontalStackLayout>
                            <Label Text="THIS WEEK"
                                   FontSize="9"
                                   CharacterSpacing="0.8"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource TextMutedDark}" />
                        </VerticalStackLayout>
                    </Border>
                    <!-- Streak pill -->
                    <Border Grid.Column="2"
                            StrokeShape="RoundRectangle 4"
                            Stroke="Transparent"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceLight}, Dark={StaticResource CardSurfaceDark}}"
                            Padding="12,10">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding StreakCount}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimaryDark}" />
                                <Label Text="&#xE80E;"
                                       FontFamily="MaterialIcons"
                                       TextColor="#E53935"
                                       FontSize="20"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="STREAK"
                                   FontSize="9"
                                   CharacterSpacing="0.8"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource TextMutedDark}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ── My Routines Section ─────────────────────────────── -->
                <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,8,0,0">
                    <Label Grid.Column="0"
                           Text="MY ROUTINES"
                           Style="{StaticResource SectionHeader}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="See all ›"
                           FontSize="12"
                           TextColor="{StaticResource Accent}"
                           VerticalOptions="Center"
                           Margin="0,0,12,0"
                           IsVisible="{Binding HasRoutines}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SeeAllRoutinesCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Border Grid.Column="2"
                            StrokeShape="RoundRectangle 4"
                            StrokeThickness="1"
                            Stroke="{StaticResource Accent}"
                            BackgroundColor="Transparent"
                            Padding="10,4"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NewRoutineCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="+ NEW"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="0.8"
                               TextColor="{StaticResource Accent}" />
                    </Border>
                </Grid>

                <!-- Empty state -->
                <VerticalStackLayout IsVisible="{Binding HasNoRoutines}"
                                     Spacing="4"
                                     HorizontalOptions="Center"
                                     Margin="0,8,0,0">
                    <Label Text="No routines yet"
                           FontSize="14"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Text="Tap '+ NEW' to create your first routine."
                           FontSize="12"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                </VerticalStackLayout>

                <!-- Data-bound routine cards -->
                <VerticalStackLayout IsVisible="{Binding HasRoutines}"
                                     Spacing="10"
                                     BindableLayout.ItemsSource="{Binding Routines}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:RoutineSummaryDto">
                            <Border StrokeShape="RoundRectangle 4"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceLight}, Dark={StaticResource CardSurfaceDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                                    Padding="14,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=EditRoutineCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <BoxView Grid.Column="0"
                                             WidthRequest="4"
                                             HeightRequest="36"
                                             Color="{Binding CategoryHexColor}"
                                             VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimaryDark}" />
                                        <Label FontSize="12"
                                               TextColor="{StaticResource TextSecondaryDark}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding ExerciseLabel}" />
                                                    <Span Text="  ·  " />
                                                    <Span Text="{Binding DurationLabel}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <!-- Play button (outline) → starts the routine -->
                                    <Border Grid.Column="2"
                                            StrokeShape="RoundRectangle 4"
                                            StrokeThickness="1.5"
                                            Stroke="{StaticResource Accent}"
                                            BackgroundColor="Transparent"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=StartRoutineCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="▶"
                                               FontSize="14"
                                               TextColor="{StaticResource Accent}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Margin="2,0,0,0" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Bottom spacer so last card clears the floating nav bar -->
                <BoxView HeightRequest="96" Color="Transparent" />

            </VerticalStackLayout>
        </ScrollView>
        </Grid>

        <!-- ── Custom bottom nav bar (overlays content at bottom) ──────── -->
        <controls:BottomNavBar Grid.Row="1"
                               ActiveTab="home"
                               VerticalOptions="End" />

    </Grid>
</ContentPage>
