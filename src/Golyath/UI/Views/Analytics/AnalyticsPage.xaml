<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Golyath.UI.ViewModels.Analytics"
             xmlns:controls="clr-namespace:Golyath.UI.Controls"
             x:Class="Golyath.UI.Views.Analytics.AnalyticsPage"
             x:DataType="vm:AnalyticsViewModel"
             Title="Analytics"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ── Period filter ─────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource AppLightSurface}, Dark={StaticResource AppDarkSurface}}"
                Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                StrokeShape="Rectangle"
                Padding="16,8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Grid.Column="0"
                       Text="Period:"
                       FontSize="13"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />
                <Picker Grid.Column="1"
                        ItemsSource="{x:Static vm:AnalyticsViewModel.PeriodOptions}"
                        SelectedItem="{Binding SelectedPeriod}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light=#111111, Dark=White}"
                        BackgroundColor="Transparent" />
            </Grid>
        </Border>

        <!-- ── Metric tab bar ────────────────────────────────────────────── -->
        <Border Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource AppLightSurface}, Dark={StaticResource AppDarkSurface}}"
                Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                StrokeShape="Rectangle"
                Padding="12,6">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">

                <Border Grid.Column="0"
                        BackgroundColor="{Binding StrengthTabBg}"
                        StrokeShape="RoundRectangle 8"
                        Stroke="Transparent">
                    <Button Text="Strength"
                            Command="{Binding SelectMetricCommand}"
                            CommandParameter="0"
                            BackgroundColor="Transparent"
                            TextColor="{Binding StrengthTabText}"
                            FontSize="13"
                            Padding="0,8" />
                </Border>

                <Border Grid.Column="1"
                        BackgroundColor="{Binding VolumeTabBg}"
                        StrokeShape="RoundRectangle 8"
                        Stroke="Transparent">
                    <Button Text="Volume"
                            Command="{Binding SelectMetricCommand}"
                            CommandParameter="1"
                            BackgroundColor="Transparent"
                            TextColor="{Binding VolumeTabText}"
                            FontSize="13"
                            Padding="0,8" />
                </Border>

                <Border Grid.Column="2"
                        BackgroundColor="{Binding MusclesTabBg}"
                        StrokeShape="RoundRectangle 8"
                        Stroke="Transparent">
                    <Button Text="Muscles"
                            Command="{Binding SelectMetricCommand}"
                            CommandParameter="2"
                            BackgroundColor="Transparent"
                            TextColor="{Binding MusclesTabText}"
                            FontSize="13"
                            Padding="0,8" />
                </Border>

            </Grid>
        </Border>

        <!-- ── Chart content ─────────────────────────────────────────────── -->
        <Grid Grid.Row="2">

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Accent}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

            <!-- ── Strength progression ───────────────────────────────────── -->
            <ScrollView IsVisible="{Binding IsStrengthVisible}">
                <VerticalStackLayout Padding="16" Spacing="12">

                    <!-- Exercise picker -->
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AppLightSurface}, Dark={StaticResource AppDarkSurface}}"
                            Padding="12,8">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="EXERCISE"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.2"
                                   TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />
                            <Picker ItemsSource="{Binding ExerciseOptions}"
                                    SelectedItem="{Binding SelectedExercise}"
                                    ItemDisplayBinding="{Binding Name}"
                                    FontSize="14"
                                    TextColor="{AppThemeBinding Light=#111111, Dark=White}"
                                    BackgroundColor="Transparent" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Chart card -->
                    <Border StrokeShape="RoundRectangle 16"
                            Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AppLightSurface}, Dark={StaticResource AppDarkSurface}}"
                            Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="STRENGTH PROGRESSION"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.2"
                                   TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />
                            <Label Text="{Binding StrengthExerciseName}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#111111, Dark=White}" />
                            <controls:LineChart Points="{Binding StrengthPoints}"
                                               HeightRequest="220" />
                        </VerticalStackLayout>
                    </Border>

                    <Label IsVisible="{Binding HasStrengthData, Converter={StaticResource InvertBoolConverter}}"
                           Text="Log more sessions to see your strength curve here."
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#888888, Dark=#888888}"
                           Margin="0,8" />

                </VerticalStackLayout>
            </ScrollView>

            <!-- ── Volume trend ───────────────────────────────────────────── -->
            <ScrollView IsVisible="{Binding IsVolumeVisible}">
                <VerticalStackLayout Padding="16" Spacing="12">

                    <Border StrokeShape="RoundRectangle 16"
                            Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AppLightSurface}, Dark={StaticResource AppDarkSurface}}"
                            Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="WEEKLY TRAINING VOLUME"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.2"
                                   TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />
                            <Label Text="Total weight moved per week (kg × reps)"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />
                            <controls:VolumeBarChart Points="{Binding VolumePoints}"
                                                     HeightRequest="220" />
                        </VerticalStackLayout>
                    </Border>

                    <Label IsVisible="{Binding HasVolumeData, Converter={StaticResource InvertBoolConverter}}"
                           Text="Complete workouts to see your weekly volume trend here."
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#888888, Dark=#888888}"
                           Margin="0,8" />

                </VerticalStackLayout>
            </ScrollView>

            <!-- ── Muscle distribution ────────────────────────────────────── -->
            <ScrollView IsVisible="{Binding IsMusclesVisible}">
                <VerticalStackLayout Padding="16" Spacing="12">

                    <Border StrokeShape="RoundRectangle 16"
                            Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AppLightSurface}, Dark={StaticResource AppDarkSurface}}"
                            Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="MUSCLE GROUP DISTRIBUTION"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.2"
                                   TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />
                            <Label Text="Completed sets by primary muscle"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#888888, Dark=#888888}" />
                            <controls:HorizontalBarChart Items="{Binding MuscleDistribution}"
                                                         HeightRequest="{Binding MuscleChartHeight}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label IsVisible="{Binding HasMuscleData, Converter={StaticResource InvertBoolConverter}}"
                           Text="Log workouts to see which muscle groups you train most."
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#888888, Dark=#888888}"
                           Margin="0,8" />

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

    </Grid>
</ContentPage>
