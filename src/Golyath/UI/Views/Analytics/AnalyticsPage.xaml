<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Golyath.UI.ViewModels.Analytics"
             xmlns:controls="clr-namespace:Golyath.UI.Controls"
             xmlns:dto="clr-namespace:Golyath.Application.DTOs;assembly=Golyath"
             x:Class="Golyath.UI.Views.Analytics.AnalyticsPage"
             x:DataType="vm:AnalyticsViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}">

    <Grid>

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16,16,16,96">

            <!-- ── Header ──────────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding PeriodLabel}"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1.2"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                <Label Text="Progress"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </VerticalStackLayout>

            <!-- ── Period pills ───────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                        BackgroundColor="{Binding Period4WBg}"
                        Padding="0,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPeriodCommand}" CommandParameter="4W" />
                    </Border.GestureRecognizers>
                    <Label Text="4W" HorizontalOptions="Center"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{Binding Period4WText}" />
                </Border>

                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                        BackgroundColor="{Binding Period3MBg}"
                        Padding="0,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPeriodCommand}" CommandParameter="3M" />
                    </Border.GestureRecognizers>
                    <Label Text="3M" HorizontalOptions="Center"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{Binding Period3MText}" />
                </Border>

                <Border Grid.Column="2"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                        BackgroundColor="{Binding Period6MBg}"
                        Padding="0,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPeriodCommand}" CommandParameter="6M" />
                    </Border.GestureRecognizers>
                    <Label Text="6M" HorizontalOptions="Center"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{Binding Period6MText}" />
                </Border>

                <Border Grid.Column="3"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                        BackgroundColor="{Binding PeriodAllBg}"
                        Padding="0,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPeriodCommand}" CommandParameter="ALL" />
                    </Border.GestureRecognizers>
                    <Label Text="ALL" HorizontalOptions="Center"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{Binding PeriodAllText}" />
                </Border>
            </Grid>

            <!-- ── 1RM Trend ───────────────────────────────────────────── -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="1RM TREND" Style="{StaticResource SectionHeader}" />

                    <!-- Exercise picker -->
                    <Border StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}"
                            Padding="12,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnExercisePickerTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding StrengthExerciseName}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="&#xE5CF;"
                                   FontFamily="MaterialIcons"
                                   FontSize="20"
                                   TextColor="#FFD700"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <controls:AnimatedLineChart Points="{Binding StrengthPoints}"
                                               IsVisible="{Binding HasStrengthData}"
                                               HeightRequest="160"
                                               HorizontalOptions="Fill" />

                    <Label Text="No data for the selected exercise / period."
                           IsVisible="{Binding HasStrengthData, Converter={StaticResource InvertBoolConverter}}"
                           HorizontalOptions="Center"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                </VerticalStackLayout>
            </Border>

            <!-- ── Muscle Balance ──────────────────────────────────────── -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="MUSCLE BALANCE" Style="{StaticResource SectionHeader}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">

                        <!-- Human figure -->
                        <controls:BodyMapView Grid.Column="0"
                                             MuscleWeights="{Binding MuscleWeights}"
                                             IsFrontView="True"
                                             HeightRequest="180"
                                             WidthRequest="90"
                                             VerticalOptions="Center"
                                             HorizontalOptions="Center" />

                        <!-- 5 muscle bars -->
                        <VerticalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                            <BindableLayout.ItemsSource>
                                <Binding Path="MuscleBalance" />
                            </BindableLayout.ItemsSource>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dto:MuscleBalanceItem">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding Label}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               CharacterSpacing="0.5"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                        <ProgressBar Progress="{Binding Fraction}"
                                                     ProgressColor="#FFD700"
                                                     BackgroundColor="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark=#2A2A2A}"
                                                     HeightRequest="6" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ── Gauges row ──────────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <!-- Recovery -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="RECOVERY" Style="{StaticResource SectionHeader}"
                               HorizontalOptions="Center" />
                        <Grid>
                            <controls:RadialGauge Value="{Binding RecoveryGaugeValue}"
                                                  GaugeColor="{Binding RecoveryGaugeColor}"
                                                  IsSemiCircle="True"
                                                  StrokeWidth="12"
                                                  HeightRequest="90"
                                                  WidthRequest="140"
                                                  HorizontalOptions="Center" />
                            <Label HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   Margin="0,0,0,8"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding RecoveryScore}" />
                                        <Span Text="%" FontSize="12" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Intensity -->
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="12">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="INTENSITY" Style="{StaticResource SectionHeader}"
                               HorizontalOptions="Center" />
                        <Grid>
                            <controls:RadialGauge Value="{Binding IntensityGaugeValue}"
                                                  GaugeColor="{Binding IntensityGaugeColor}"
                                                  IsSemiCircle="True"
                                                  StrokeWidth="12"
                                                  HeightRequest="90"
                                                  WidthRequest="140"
                                                  HorizontalOptions="Center" />
                            <Label HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   Margin="0,0,0,8"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding IntensityScore}" />
                                        <Span Text="%" FontSize="12" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- ── All Insights ────────────────────────────────────────── -->
            <Label Text="INSIGHTS"
                   Style="{StaticResource SectionHeader}"
                   IsVisible="{Binding HasInsights}" />

            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasInsights}">
                <BindableLayout.ItemsSource>
                    <Binding Path="AllInsights" />
                </BindableLayout.ItemsSource>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="dto:TrainingSuggestion">
                        <Border Style="{StaticResource CardBorder}" Padding="0">
                            <Grid ColumnDefinitions="4,*">
                                <!-- Severity color bar -->
                                <BoxView Grid.Column="0"
                                         Color="{Binding PriorityColor}"
                                         CornerRadius="4,0,4,0" />
                                <Grid Grid.Column="1"
                                      ColumnDefinitions="*,Auto"
                                      Padding="12,10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Title}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Label Text="{Binding Detail}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="1"
                                            Stroke="{Binding PriorityColor}"
                                            BackgroundColor="Transparent"
                                            Padding="6,2"
                                            VerticalOptions="Start">
                                        <Label Text="{Binding PriorityLabel}"
                                               FontSize="9"
                                               FontAttributes="Bold"
                                               CharacterSpacing="0.5"
                                               TextColor="{Binding PriorityColor}" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Empty state -->
            <Label Text="No insights yet — keep training!"
                   IsVisible="{Binding HasInsights, Converter={StaticResource InvertBoolConverter}}"
                   HorizontalOptions="Center"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                   Margin="0,16" />

        </VerticalStackLayout>
    </ScrollView>

        <!-- ── Custom bottom nav bar (overlays content at bottom) ──────── -->
        <controls:BottomNavBar ActiveTab="progress"
                               VerticalOptions="End" />

    </Grid>

</ContentPage>