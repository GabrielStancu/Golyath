<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Golyath.UI.ViewModels.Analytics"
             xmlns:controls="clr-namespace:Golyath.UI.Controls"
             x:Class="Golyath.UI.Views.Analytics.AnalyticsPage"
             x:DataType="vm:AnalyticsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Header panel with filters & metric tabs ───────────────────── -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceLight}, Dark={StaticResource CardSurfaceDark}}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,20,20"
                Padding="16,16,16,12">
            <VerticalStackLayout Spacing="10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Analytics"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="Track your progress"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>

                <!-- Period filter -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="Period:"
                           FontSize="13"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource AppLightBorder}, Dark={StaticResource AppDarkBorder}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AppLightBg}, Dark={StaticResource AppDarkBg}}"
                            Padding="4,0">
                        <Picker ItemsSource="{x:Static vm:AnalyticsViewModel.PeriodOptions}"
                                SelectedItem="{Binding SelectedPeriod}"
                                FontSize="13"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                BackgroundColor="Transparent" />
                    </Border>
                </Grid>

                <!-- Metric tab bar -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <Border Grid.Column="0"
                            BackgroundColor="{Binding StrengthTabBg}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="Transparent">
                        <Button Text="Strength"
                                Command="{Binding SelectMetricCommand}"
                                CommandParameter="0"
                                BackgroundColor="Transparent"
                                TextColor="{Binding StrengthTabText}"
                                FontSize="13"
                                Padding="0,8" />
                    </Border>

                    <Border Grid.Column="1"
                            BackgroundColor="{Binding VolumeTabBg}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="Transparent">
                        <Button Text="Volume"
                                Command="{Binding SelectMetricCommand}"
                                CommandParameter="1"
                                BackgroundColor="Transparent"
                                TextColor="{Binding VolumeTabText}"
                                FontSize="13"
                                Padding="0,8" />
                    </Border>

                    <Border Grid.Column="2"
                            BackgroundColor="{Binding MusclesTabBg}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="Transparent">
                        <Button Text="Muscles"
                                Command="{Binding SelectMetricCommand}"
                                CommandParameter="2"
                                BackgroundColor="Transparent"
                                TextColor="{Binding MusclesTabText}"
                                FontSize="13"
                                Padding="0,8" />
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- ── Chart content ─────────────────────────────────────────────── -->
        <Grid Grid.Row="1">

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Accent}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

            <!-- ── Strength progression ───────────────────────────────────── -->
            <ScrollView IsVisible="{Binding IsStrengthVisible}">
                <VerticalStackLayout Padding="16" Spacing="12">

                    <!-- Exercise picker -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="EXERCISE"
                                   Style="{StaticResource SectionHeader}" />
                            <Picker ItemsSource="{Binding ExerciseOptions}"
                                    SelectedItem="{Binding SelectedExercise}"
                                    ItemDisplayBinding="{Binding Name}"
                                    FontSize="14"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                    BackgroundColor="Transparent" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Chart card -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="STRENGTH PROGRESSION"
                                   Style="{StaticResource SectionHeader}" />
                            <Label Text="{Binding StrengthExerciseName}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <controls:AnimatedLineChart Points="{Binding StrengthPoints}"
                                                        HeightRequest="220" />
                        </VerticalStackLayout>
                    </Border>

                    <Label IsVisible="{Binding HasStrengthData, Converter={StaticResource InvertBoolConverter}}"
                           Text="Log more sessions to see your strength curve here."
                           Style="{StaticResource CardSubtitle}"
                           HorizontalTextAlignment="Center"
                           Margin="0,8" />

                    <!-- Smart suggestions link -->
                    <Border Style="{StaticResource CardBorder}" Padding="12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSuggestionsTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="View Smart Suggestions →"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Accent}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ── Volume trend ───────────────────────────────────────────── -->
            <ScrollView IsVisible="{Binding IsVolumeVisible}">
                <VerticalStackLayout Padding="16" Spacing="12">

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="WEEKLY TRAINING VOLUME"
                                   Style="{StaticResource SectionHeader}" />
                            <Label Text="Total weight moved per week (kg × reps)"
                                   Style="{StaticResource CardSubtitle}" />
                            <controls:VolumeBarChart Points="{Binding VolumePoints}"
                                                     HeightRequest="220" />
                        </VerticalStackLayout>
                    </Border>

                    <Label IsVisible="{Binding HasVolumeData, Converter={StaticResource InvertBoolConverter}}"
                           Text="Complete workouts to see your weekly volume trend here."
                           Style="{StaticResource CardSubtitle}"
                           HorizontalTextAlignment="Center"
                           Margin="0,8" />

                    <!-- Smart suggestions link -->
                    <Border Style="{StaticResource CardBorder}" Padding="12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSuggestionsTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="View Smart Suggestions →"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Accent}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ── Muscle distribution ────────────────────────────────────── -->
            <ScrollView IsVisible="{Binding IsMusclesVisible}">
                <VerticalStackLayout Padding="16" Spacing="12">

                    <!-- Donut chart overview -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="MUSCLE GROUP DISTRIBUTION"
                                   Style="{StaticResource SectionHeader}" />
                            <Label Text="Completed sets by primary muscle"
                                   Style="{StaticResource CardSubtitle}" />
                            <controls:DonutChart Segments="{Binding MuscleDistribution, Converter={StaticResource MuscleGroupToDonutConverter}}"
                                                  HeightRequest="200"
                                                  Margin="0,8" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Detailed bar breakdown -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="DETAILED BREAKDOWN"
                                   Style="{StaticResource SectionHeader}" />
                            <controls:HorizontalBarChart Items="{Binding MuscleDistribution}"
                                                         HeightRequest="{Binding MuscleChartHeight}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label IsVisible="{Binding HasMuscleData, Converter={StaticResource InvertBoolConverter}}"
                           Text="Log workouts to see which muscle groups you train most."
                           Style="{StaticResource CardSubtitle}"
                           HorizontalTextAlignment="Center"
                           Margin="0,8" />

                    <!-- Smart suggestions link -->
                    <Border Style="{StaticResource CardBorder}" Padding="12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSuggestionsTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="View Smart Suggestions →"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Accent}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

    </Grid>
</ContentPage>
