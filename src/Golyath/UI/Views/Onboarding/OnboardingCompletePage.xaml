<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Golyath.Application.Localization"
             x:Class="Golyath.UI.Views.Onboarding.OnboardingCompletePage"
             BackgroundColor="{StaticResource AppDarkBg}"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*,Auto">

        <VerticalStackLayout Grid.Row="0"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="16"
                             Padding="32,0">

            <Label Text="&#xEA4A;"
                   FontFamily="MaterialIcons"
                   FontSize="72"
                   HorizontalOptions="Center" />

            <Label x:Name="WelcomeLabel"
                   Text="{Binding [Complete_Title], Source={x:Static loc:LocalizationManager.Instance}}"
                   FontSize="32" FontAttributes="Bold"
                   TextColor="{StaticResource Accent}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding [Complete_Subtitle], Source={x:Static loc:LocalizationManager.Instance}}"
                   FontSize="16"
                   TextColor="#AAAAAA"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />

        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Padding="32,0,32,64" Spacing="0">
            <Button x:Name="StartButton"
                    Text="{Binding [Complete_Button], Source={x:Static loc:LocalizationManager.Instance}}"
                    BackgroundColor="{StaticResource Accent}"
                    TextColor="{StaticResource AccentText}"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="56"
                    FontSize="16"
                    CharacterSpacing="1"
                    Clicked="OnStartTrainingClicked" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
